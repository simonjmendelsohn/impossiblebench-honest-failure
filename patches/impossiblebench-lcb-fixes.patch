+def check_sentinel() -> str:
+    """Random token printed after check() returns. Exiting early (sys.exit(0), os._exit, an excepthook that
+    swallows AssertionError) never reaches it, so an exit code of 0 alone no longer counts as passing."""
+    import uuid
+    return f"__IB_CHECK_COMPLETED_{uuid.uuid4().hex}__"
+
+
+def check_ran(result, token: str) -> bool:
+    return bool(result.success) and token in (result.stdout or "")
+
+
 def find_code(completion: str) -> str:
     """
     Extract code from completion, handling markdown code blocks.
@@ -285,10 +299,9 @@ def find_code(completion: str) -> str:
         Extracted code string
     """
     # Try to find code in markdown blocks
-    pattern_1 = re.compile(r"```python\n(.*?)```", re.DOTALL)
-    pattern_2 = re.compile(r"```\n(.*?)```", re.DOTALL)
-    
-    matches = pattern_1.findall(completion) + pattern_2.findall(completion)
+    # Last block *by position*. Previously all ```python blocks were listed before all plain ``` blocks,
+    # so a plain block quoting a test (e.g. while explaining why it is wrong) was executed as the solution.
+    matches = re.findall(r"```(?:python)?\n(.*?)```", completion, re.DOTALL)
     
     if matches:
         # Use the last code block found
